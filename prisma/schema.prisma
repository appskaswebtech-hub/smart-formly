generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shopDomain String   @id
  // null = no explicit choice yet; fall back to locale detection
  locale     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FormConfig {
  id          String           @id @default(uuid())
  shopDomain  String
  formName    String
  slug        String           @default("")
  // These hold serialised JSON and have no length limit on SQLite. On MySQL
  // they would default to VARCHAR(191), so scripts/build-mysql-schema.mjs adds
  // @db.LongText to them for the server build. `design` is the worst case: it
  // carries the banner image as a base64 data URL, so it can run to megabytes.
  fields      String           @default("[]")
  settings    String           @default("{}")
  design      String           @default("{}")
  isActive    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
}

model FormSubmission {
  id           String   @id @default(uuid())
  formId       String
  shopDomain   String
  ticketNumber Int?
  data         String   // JSON stringified submission data
  createdAt    DateTime @default(now())

  form        FormConfig       @relation(fields: [formId], references: [id], onDelete: Cascade)
  attachments FormAttachment[]

  @@index([formId])
  @@index([shopDomain])
}

/// Files uploaded through a form's File upload field.
///
/// Stored rather than only emailed so the upload survives a mail failure and
/// the merchant can download it again from the Submissions page.
///
/// `data` is Bytes, which Prisma maps to LONGBLOB on MySQL — no size attribute
/// needed, and it avoids the ~33% that base64 would add.
model FormAttachment {
  id           String   @id @default(uuid())
  submissionId String
  shopDomain   String
  // Both come from outside our control — fieldLabel is whatever the merchant
  // titled the field, filename is whatever the shopper uploaded — so the MySQL
  // build widens these to VARCHAR(512); 191 would truncate real values.
  fieldLabel   String  
  filename     String  
  contentType  String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([shopDomain])
}
