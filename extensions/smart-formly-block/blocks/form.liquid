{% comment %}
  SmartFormly — Form Block
  Supports: inline · centered popup (button / delay / exit_intent) · floating bottom bar (bottom sheet)
  Features: schedule gate · allow logged-in only · ticket system · custom messages · scroll behavior · after-submit script · show once per user
{% endcomment %}

{%- assign app_url = app.metafields.smartformly.app_url | default: "" -%}

{% if block.settings.form_id == blank %}
  {% if request.design_mode %}
    <div style="padding:40px;text-align:center;border:2px dashed #ccc;border-radius:8px;color:#666;font-family:sans-serif;">
      <p style="font-size:16px;font-weight:600;margin-bottom:8px;">{{ 'smartformly.editor.no_form_id_title' | t }}</p>
      <p style="font-size:13px;">{{ 'smartformly.editor.no_form_id_body' | t }}</p>
    </div>
  {% endif %}
{% elsif app_url == blank %}
  {% if request.design_mode %}
    <div style="padding:20px;text-align:center;border:2px dashed #f59e0b;border-radius:8px;color:#92400e;font-family:sans-serif;font-size:13px;">
      {{ 'smartformly.editor.not_configured' | t }}
    </div>
  {% endif %}
{% else %}

  <div
    id="smartformly-form-{{ block.settings.form_id }}"
    class="smartformly-wrapper"
    data-form-id="{{ block.settings.form_id }}"
    data-app-url="{{ app_url }}"
    data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
    style="max-width:{{ block.settings.max_width }}px;margin:0 auto;padding:{{ block.settings.section_padding }}px 0;"
  >
    <div class="smartformly-loading" style="text-align:center;padding:40px 0;color:#999;">
      {{ 'smartformly.form.loading' | t }}
    </div>
  </div>

  {% comment %}smart-formly.js is intentionally not loaded — all logic is inline below{% endcomment %}

  <style>
    /* ─── Base ─── */
    .smartformly-wrapper { font-family: inherit; }

    .smartformly-form {
      padding: var(--sf-padding, 30px);
      border: var(--sf-border-size, 2px) solid var(--sf-border-color, #000);
      border-radius: var(--sf-border-radius, 1px);
      background: var(--sf-bg, transparent);
      box-shadow: var(--sf-shadow, none);
    }
    .smartformly-form h2 { font-size:20px; font-weight:600; margin:0 0 4px 0; }
    .smartformly-form .sf-description { font-size:13px; color:#6B7280; margin:0 0 16px 0; }
    .smartformly-form .sf-banner { margin-bottom:16px; }
    .smartformly-form .sf-banner img { max-width:100%; object-fit:cover; border-radius:4px; }

    /* ─── Fields ─── */
    .smartformly-fields { display:flex; flex-wrap:wrap; gap:16px; }
    .smartformly-field  { width:100%; }
    .smartformly-field.half-width { width:calc(50% - 8px); }

    .smartformly-field label { display:block; margin-bottom:6px; font-weight:500; }

    .smartformly-field input[type="text"],
    .smartformly-field input[type="email"],
    .smartformly-field input[type="tel"],
    .smartformly-field input[type="phone"],
    .smartformly-field input[type="number"],
    .smartformly-field input[type="date"],
    .smartformly-field input[type="time"],
    .smartformly-field textarea,
    .smartformly-field select {
      width:100%; padding:8px 10px;
      border:1px solid var(--sf-input-border,#000);
      border-radius:var(--sf-input-radius,1px);
      background:var(--sf-input-bg,#fff);
      font-size:var(--sf-input-font-size,14px);
      color:var(--sf-input-color,#000);
      font-family:inherit; box-sizing:border-box;
    }
    .smartformly-field input:focus,
    .smartformly-field textarea:focus,
    .smartformly-field select:focus { outline:none; border-color:var(--sf-input-focus,#5C6AC4); }
    .smartformly-field textarea { resize:vertical; min-height:80px; }

    .smartformly-field .sf-checkbox-group { display:flex; flex-direction:column; gap:6px; }
    .smartformly-field .sf-checkbox-group label { display:flex; align-items:center; gap:8px; font-weight:normal; margin-bottom:0; }

    /* ─── Field-level validation highlight ─── */
    .smartformly-field.sf-field-error input,
    .smartformly-field.sf-field-error textarea,
    .smartformly-field.sf-field-error select { border-color:#DC2626 !important; }
    .smartformly-field .sf-field-error-msg { font-size:12px; color:#DC2626; margin-top:4px; display:none; }
    .smartformly-field.sf-field-error .sf-field-error-msg { display:block; }

    .smartformly-submit { width:100%; margin-top:4px; }
    .smartformly-submit button { padding:10px 24px; font-weight:600; cursor:pointer; font-family:inherit; transition:opacity .2s; }
    .smartformly-submit button:hover    { opacity:.9; }
    .smartformly-submit button:disabled { opacity:.5; cursor:not-allowed; }

    /* ─── Messages ─── */
    .smartformly-success { padding:20px; text-align:center; background:#d4edda; color:#155724; border:1px solid #c3e6cb; border-radius:6px; font-size:15px; font-weight:500; margin-top:12px; }
    .smartformly-error   { padding:10px 14px; background:#FEE2E2; color:#DC2626; border-radius:6px; font-size:13px; margin-bottom:12px; }
    .sf-thankyou         { margin-top:16px; padding:20px; background:#EEF0FB; border:1px solid #c3c8f5; border-radius:8px; text-align:center; }
    .sf-thankyou-msg     { font-size:15px; color:#111827; margin-bottom:10px; }
    .sf-thankyou-timer   { font-size:12px; color:#6B7280; }
    .sf-schedule-msg     { padding:20px; text-align:center; font-family:inherit; font-size:14px; color:#6B7280; border:1px solid #E5E7EB; border-radius:8px; background:#F9FAFB; }

    /* ─── Ticket badge ─── */
    .sf-ticket-badge {
      display:inline-block; margin-top:10px;
      padding:6px 14px; background:#5C6AC4; color:#fff;
      border-radius:20px; font-size:13px; font-weight:600;
      letter-spacing:.03em;
    }

    /* ─── Login gate message ─── */
    .sf-login-msg {
      padding:24px 20px; text-align:center;
      font-family:inherit; font-size:14px; color:#374151;
      border:1px solid #E5E7EB; border-radius:8px;
      background:#F9FAFB; white-space:pre-line; line-height:1.7;
    }

    /* ─── Centered popup overlay ─── */
    .sf-popup-overlay {
      display:none;
      position:fixed; inset:0;
      z-index:99999;
      align-items:center;
      justify-content:center;
      padding:20px;
      box-sizing:border-box;
    }
    .sf-popup-overlay.sf-popup-open { display:flex; }

    .sf-popup-modal {
      position:relative; z-index:1;
      background:#fff; border-radius:10px;
      width:100%; max-height:90vh; overflow-y:auto;
      box-shadow:0 20px 60px rgba(0,0,0,.3);
      animation:sfPopupIn .25s ease;
    }
    @keyframes sfPopupIn {
      from { opacity:0; transform:translateY(-20px) scale(.97); }
      to   { opacity:1; transform:translateY(0)     scale(1);   }
    }

    .sf-popup-close {
      position:absolute; top:12px; right:14px;
      background:rgba(0,0,0,.08); border:none; border-radius:50%;
      width:30px; height:30px; font-size:16px; line-height:1;
      cursor:pointer; display:flex; align-items:center; justify-content:center;
      color:#444; z-index:2; transition:background .15s;
    }
    .sf-popup-close:hover { background:rgba(0,0,0,.15); }
    .sf-popup-inner { padding:24px; }

    /* ─── Bottom-sheet (floating_button trigger) ─── */
    .sf-popup-overlay.sf-popup-bottomsheet { align-items:flex-end; padding:0; }
    .sf-popup-overlay.sf-popup-bottomsheet .sf-popup-modal {
      position:relative; bottom:0; left:0; right:0;
      max-width:100% !important; width:100% !important;
      max-height:85vh;
      border-radius:20px 20px 0 0;
      box-shadow:0 -8px 40px rgba(0,0,0,.25);
      animation:sfSheetUp .32s cubic-bezier(.32,.72,0,1);
    }
    @keyframes sfSheetUp {
      from { transform:translateY(100%); opacity:.6; }
      to   { transform:translateY(0);    opacity:1; }
    }
    .sf-sheet-handle {
      width:40px; height:4px; background:rgba(0,0,0,.15);
      border-radius:2px; margin:14px auto 0;
    }

    /* ─── Floating bottom bar ─── */
    .sf-floating-bar {
      display:none; position:fixed;
      bottom:0; left:0; right:0; z-index:99998;
      box-shadow:0 -4px 24px rgba(0,0,0,.18);
      transition:transform .3s ease, opacity .3s ease;
    }
    .sf-floating-bar.sf-floating-visible { display:block; }
    .sf-floating-bar.sf-floating-hidden  { transform:translateY(100%); opacity:0; }
    .sf-floating-bar button {
      width:100%; padding:18px 24px;
      font-size:16px; font-weight:600;
      border:none; cursor:pointer; font-family:inherit;
      letter-spacing:.015em; transition:opacity .2s, filter .2s;
      display:flex; align-items:center; justify-content:center; gap:8px;
    }
    .sf-floating-bar button:hover  { filter:brightness(1.08); }
    .sf-floating-bar button:active { filter:brightness(.95); }
    body.sf-has-floating-bar { padding-bottom:64px !important; }

    /* ─── Responsive ─── */
    @media (max-width:600px) {
      .smartformly-field.half-width { width:100%; }
      .sf-popup-modal { border-radius:6px; }
      .sf-popup-overlay.sf-popup-bottomsheet .sf-popup-modal { border-radius:16px 16px 0 0; }
    }
  </style>

  <script>
  (function() {
    /* Storefront copy, resolved by Liquid against this extension's locale files
       using the shop's active language. Declared inside the IIFE so two blocks
       on one page can't clobber each other. `| json` handles quoting/escaping —
       never hand-quote these.

       Precedence everywhere below is:
         per-form merchant override (globalExtra.*)  >  T.*  >  nothing */
    var T = {
      submit:        {{ 'smartformly.form.submit'         | t | json }},
      submitting:    {{ 'smartformly.form.submitting'     | t | json }},
      requiredField: {{ 'smartformly.form.required_field' | t | json }},
      numberRange:   {{ 'smartformly.form.invalid_number_range' | t | json }},
      numberMin:     {{ 'smartformly.form.invalid_number_min'   | t | json }},
      numberMax:     {{ 'smartformly.form.invalid_number_max'   | t | json }},
      pastDate:      {{ 'smartformly.form.past_date'            | t | json }},
      loginRequired: {{ 'smartformly.form.login_required' | t | json }},
      genericError:  {{ 'smartformly.form.generic_error'  | t | json }},
      success:       {{ 'smartformly.form.success'        | t | json }},
      ticket:        {{ 'smartformly.form.ticket'         | t | json }},
      closingIn:     {{ 'smartformly.form.closing_in'     | t | json }}
    };

    /* The storefront's active language, forwarded to the API so it can localize
       the one message it renders server-side. */
    var SF_LOCALE = {{ request.locale.iso_code | json }};

    var wrapper        = document.getElementById('smartformly-form-{{ block.settings.form_id }}');
    var formId         = wrapper.dataset.formId;
    var appUrl = (wrapper.dataset.appUrl || '')
      .replace(/^http:\/\//, 'https://')
      .replace(/\/$/, '');
    var customerLoggedIn = wrapper.dataset.customerLoggedIn === 'true';

    var globalFields   = [];
    var globalSettings = {};
    var globalDesign   = {};
    var globalExtra    = {};

    /* ════════════════════════════════════════════
       HELPERS
    ════════════════════════════════════════════ */
    function hexToRgba(hex, opacity) {
      if (!hex || hex.indexOf('rgba') === 0) return hex || 'rgba(0,0,0,0.5)';
      hex = hex.replace('#', '');
      if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
      var r = parseInt(hex.substring(0,2),16);
      var g = parseInt(hex.substring(2,4),16);
      var b = parseInt(hex.substring(4,6),16);
      return 'rgba('+r+','+g+','+b+','+opacity+')';
    }

    function escHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;');
    }

    /* Local (not UTC) yyyy-mm-dd — the format <input type="date"> uses. */
    function todayISO() {
      var n = new Date();
      return n.getFullYear() + '-' +
             String(n.getMonth() + 1).padStart(2, '0') + '-' +
             String(n.getDate()).padStart(2, '0');
    }

    /* <input type="date"> always hands back yyyy-mm-dd. This only changes how
       the value is recorded for the merchant, never what the picker shows. */
    function formatDate(iso, fmt) {
      var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
      if (!m) return iso || '';
      if (fmt === 'us') return m[2] + '/' + m[3] + '/' + m[1];
      if (fmt === 'uk') return m[3] + '/' + m[2] + '/' + m[1];
      return iso;
    }

    /* ════════════════════════════════════════════
       SCHEDULE CHECK
    ════════════════════════════════════════════ */
    function getScheduleMessage() {
      var extra = globalExtra;
      var now   = new Date();
      if (extra.scheduleStartDate) {
        var start = new Date(extra.scheduleStartDate + 'T' + (extra.scheduleStartTime || '00:00'));
        if (now < start) return extra.beforeStartMessage || 'This form is not open yet.';
      }
      if (extra.scheduleEndDate) {
        var end = new Date(extra.scheduleEndDate + 'T' + (extra.scheduleEndTime || '23:59'));
        if (now > end) return extra.afterEndMessage || 'This form has closed.';
      }
      return null;
    }

    /* ════════════════════════════════════════════
       SCROLL BEHAVIOR
    ════════════════════════════════════════════ */
    function getScrollableParent(el) {
      var parent = el.parentElement;
      while (parent && parent !== document.body) {
        var style    = window.getComputedStyle(parent);
        var overflow = style.overflow + style.overflowY + style.overflowX;
        if (/(auto|scroll)/.test(overflow) && parent.scrollHeight > parent.clientHeight) {
          return parent;
        }
        parent = parent.parentElement;
      }
      return document.scrollingElement || document.documentElement;
    }

    function smoothScrollTo(el, offset) {
      if (!el) return;
      var scroller     = getScrollableParent(el);
      var isRootScroll = (scroller === document.documentElement || scroller === document.body);
      var elRect       = el.getBoundingClientRect();
      var scrollerTop  = isRootScroll ? 0 : scroller.getBoundingClientRect().top;
      var currentScroll = isRootScroll
        ? (window.scrollY || window.pageYOffset)
        : scroller.scrollTop;
      var targetPos = elRect.top - scrollerTop + currentScroll - offset;
      try {
        scroller.scrollTo({ top: targetPos, behavior: 'smooth' });
        if (isRootScroll) window.scrollTo({ top: targetPos, behavior: 'smooth' });
      } catch (e) {
        scroller.scrollTop = targetPos;
        if (isRootScroll) window.scrollTo(0, targetPos);
      }
    }

    function handleScrollBehavior(container) {
      if (globalExtra.popupEnabled) return;
      var behavior = globalExtra.scrollBehavior || 'scroll_to_top';
      if (behavior === 'none') return;
      var offset = Number(globalExtra.scrollOffset) || 0;
      var target;
      if (behavior === 'scroll_to_message') {
        target = container.querySelector('.smartformly-success, .sf-thankyou');
      }
      if (!target) target = wrapper;
      smoothScrollTo(target, offset);
    }

    /* ════════════════════════════════════════════
       LOAD FORM CONFIG
    ════════════════════════════════════════════ */
    async function loadForm() {
      try {
        var res = await fetch(appUrl + '/api/forms/' + formId);
        if (!res.ok) throw new Error('not found');
        var data = await res.json();
        initForm(data);
      } catch (err) {
        wrapper.innerHTML = '<div style="padding:20px;text-align:center;color:#999;">Unable to load form. Please check the Form ID.</div>';
      }
    }

    function initForm(config) {
      globalFields   = typeof config.fields   === 'string' ? JSON.parse(config.fields)   : (config.fields   || []);
      globalSettings = typeof config.settings === 'string' ? JSON.parse(config.settings) : (config.settings || {});
      globalDesign   = globalSettings.design || {};
      globalExtra    = globalSettings.extra  || {};

      if (globalExtra.allowLoggedInOnly === true && !customerLoggedIn) {
        var loginMsg = (globalExtra.loginMessage || T.loginRequired).trim();
        wrapper.innerHTML = '<div class="sf-login-msg">' + escHtml(loginMsg) + '</div>';
        return;
      }

      if (globalExtra.popupEnabled === true) {
        renderPopupMode(config);
      } else {
        renderInlineMode(config);
      }
    }

    /* ════════════════════════════════════════════
       OVERLAY / MODAL FACTORY
    ════════════════════════════════════════════ */
    function buildOverlayModal(trigger) {
      var isSheet    = (trigger === 'floating_button');
      var overlayHex = globalExtra.popupOverlayBg      || '#000000';
      var overlayOp  = globalExtra.popupOverlayOpacity || '0.5';
      var popupWidth = globalExtra.popupWidth          || '600';
      var closeOnBg  = globalExtra.popupCloseOnOverlay !== false;

      var overlay = document.createElement('div');
      overlay.id        = 'sf-overlay-' + formId;
      overlay.className = 'sf-popup-overlay' + (isSheet ? ' sf-popup-bottomsheet' : '');
      overlay.style.background = hexToRgba(overlayHex, overlayOp);
      if (closeOnBg) {
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closePopup();
        });
      }

      var modal = document.createElement('div');
      modal.className = 'sf-popup-modal';
      if (!isSheet) modal.style.maxWidth = popupWidth + 'px';

      if (isSheet) {
        var handle = document.createElement('div');
        handle.className = 'sf-sheet-handle';
        modal.appendChild(handle);
      }

      var closeBtn = document.createElement('button');
      closeBtn.className = 'sf-popup-close';
      closeBtn.innerHTML = '&times;';
      closeBtn.setAttribute('aria-label', 'Close');
      closeBtn.addEventListener('click', closePopup);
      modal.appendChild(closeBtn);

      var inner = document.createElement('div');
      inner.className = 'sf-popup-inner';
      inner.id        = 'sf-popup-inner-' + formId;
      modal.appendChild(inner);

      overlay.appendChild(modal);
      document.body.appendChild(overlay);

      var scheduleMsg = getScheduleMessage();
      if (scheduleMsg) {
        inner.innerHTML = '<div class="sf-schedule-msg">' + escHtml(scheduleMsg) + '</div>';
      } else {
        renderFormHtml(inner, currentConfig);
      }
    }

    /* ════════════════════════════════════════════
       POPUP MODE
    ════════════════════════════════════════════ */
    var currentConfig = null;

    function renderPopupMode(config) {
      currentConfig = config;
      var trigger   = globalExtra.popupTrigger || 'button';

      /* ── ✅ Show once per user (localStorage) ── */
      var showOnce    = globalExtra.popupShowOnce === true;
      var storageKey  = 'sf_popup_seen_' + formId;
      var alreadySeen = false;
      try { alreadySeen = localStorage.getItem(storageKey) === '1'; } catch(e) {}

      /* Button trigger always shows — user clicked intentionally */
      if (showOnce && alreadySeen && trigger !== 'button') {
        wrapper.innerHTML = '';
        return;
      }

      buildOverlayModal(trigger);

      if (trigger === 'button') {
        wrapper.innerHTML = '';
        var btn = document.createElement('button');
        btn.textContent   = globalExtra.popupButtonText  || 'Open Form';
        btn.style.cssText = [
          'padding:10px 24px',
          'background:' + (globalExtra.popupButtonBg    || '#000000'),
          'color:'      + (globalExtra.popupButtonColor || '#ffffff'),
          'border:none', 'border-radius:6px',
          'font-size:15px', 'font-weight:600',
          'cursor:pointer', 'font-family:inherit',
          'transition:opacity .2s',
        ].join(';');
        btn.onmouseover = function() { btn.style.opacity = '0.85'; };
        btn.onmouseout  = function() { btn.style.opacity = '1'; };
        btn.addEventListener('click', openPopup);
        wrapper.appendChild(btn);

      } else if (trigger === 'delay') {
        wrapper.innerHTML = '';
        setTimeout(openPopup, (Number(globalExtra.popupDelay) || 3) * 1000);

      } else if (trigger === 'exit_intent') {
        wrapper.innerHTML = '';
        var exitFired = false;
        document.addEventListener('mouseleave', function(e) {
          if (!exitFired && e.clientY <= 0) { exitFired = true; openPopup(); }
        });

      } else if (trigger === 'floating_button') {
        wrapper.innerHTML = '';
        var bar = document.createElement('div');
        bar.id        = 'sf-bar-' + formId;
        bar.className = 'sf-floating-bar';
        var barBtn = document.createElement('button');
        barBtn.textContent      = globalExtra.popupFloatingBtnText  || 'Fill out our form';
        barBtn.style.background = globalExtra.popupFloatingBtnBg    || '#000000';
        barBtn.style.color      = globalExtra.popupFloatingBtnColor || '#ffffff';
        barBtn.addEventListener('click', openPopup);
        bar.appendChild(barBtn);
        document.body.appendChild(bar);
        document.body.classList.add('sf-has-floating-bar');
        setTimeout(function() { bar.classList.add('sf-floating-visible'); }, 350);
      }
    }

    function openPopup() {
      var overlay = document.getElementById('sf-overlay-' + formId);
      if (!overlay) return;
      /* ── ✅ Mark as seen in localStorage ── */
      try { localStorage.setItem('sf_popup_seen_' + formId, '1'); } catch(e) {}
      overlay.classList.add('sf-popup-open');
      document.body.style.overflow = 'hidden';
      var bar = document.getElementById('sf-bar-' + formId);
      if (bar) {
        bar.classList.add('sf-floating-hidden');
        setTimeout(function() { bar.style.display = 'none'; }, 300);
      }
    }

    function closePopup() {
      var overlay = document.getElementById('sf-overlay-' + formId);
      if (!overlay) return;
      overlay.classList.remove('sf-popup-open');
      document.body.style.overflow = '';
      var bar = document.getElementById('sf-bar-' + formId);
      if (bar) {
        bar.style.display = 'block';
        setTimeout(function() { bar.classList.remove('sf-floating-hidden'); }, 10);
      }
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closePopup();
    });

    /* ════════════════════════════════════════════
       INLINE MODE
    ════════════════════════════════════════════ */
    function renderInlineMode(config) {
      var scheduleMsg = getScheduleMessage();
      if (scheduleMsg) {
        wrapper.innerHTML = '<div class="sf-schedule-msg">' + escHtml(scheduleMsg) + '</div>';
        return;
      }
      renderFormHtml(wrapper, config);
    }

    /* ════════════════════════════════════════════
       FORM RENDERER
    ════════════════════════════════════════════ */
    function renderFormHtml(container, config) {
      var d = globalDesign;

      var cssVars = {
        '--sf-padding':        (d.formPadding  || '30') + 'px',
        '--sf-border-size':    (d.borderSize   || '2')  + 'px',
        '--sf-border-color':    d.borderColor   || '#000',
        '--sf-border-radius':  (d.borderRadius || '1')  + 'px',
        '--sf-bg':
          d.bgType === 'color'    ? (d.bgColor || '#fff') :
          d.bgType === 'gradient' ? 'linear-gradient(135deg,' + (d.bgColor||'#fff') + ',' + (d.bgColor2||'#f0f0f0') + ')' :
          'transparent',
        '--sf-shadow':          d.bgShadow && d.bgShadow !== 'none' ? d.bgShadow : 'none',
        '--sf-input-border':    d.inputBorderColor      || '#000',
        '--sf-input-radius':   (d.inputBorderRadius     || '1') + 'px',
        '--sf-input-bg':        d.inputBg               || '#fff',
        '--sf-input-font-size':(d.inputFontSize         || '14') + 'px',
        '--sf-input-color':     d.inputFontColor        || '#000',
        '--sf-input-focus':     d.inputBorderFocusColor || '#5C6AC4',
      };

      var style = '';
      for (var k in cssVars) style += k + ':' + cssVars[k] + ';';

      var html = '<form class="smartformly-form" style="' + style + '" novalidate>';

      if (d.formBannerUrl) {
        html += '<div class="sf-banner" style="text-align:' + (d.formBannerAlignment || 'center') + '">';
        html += '<img src="' + d.formBannerUrl + '" style="height:' + (d.formBannerHeight||'200') + 'px;max-width:' + (d.formBannerWidth||'100%') + '">';
        html += '</div>';
      }

      html += '<h2>' + escHtml(config.formName || 'Form') + '</h2>';
      if (d.formDescription) {
        html += '<p class="sf-description">' + escHtml(d.formDescription) + '</p>';
      }

      html += '<div class="smartformly-error" id="sf-error-' + formId + '" style="display:none"></div>';
      html += '<div class="smartformly-fields">';

      globalFields.forEach(function(f) {
        var halfCls   = f.halfWidth     ? ' half-width' : '';
        var centerSty = f.fieldInCenter ? 'text-align:center;' : '';
        var labelSty  = 'font-size:' + (d.labelFontSize||'14') + 'px;color:' + (d.labelColor||'#000') + ';';
        var req       = f.required ? '<span style="color:red;margin-left:2px">*</span>' : '';
        var nameAttr  = 'name="' + escHtml(f.label) + '"';
        var dataReq   = f.required ? ' data-required="1"' : '';

        html += '<div class="smartformly-field' + halfCls + '" style="' + centerSty + '" data-field-label="' + escHtml(f.label) + '">';

        if (d.labelStyle !== 'floating') {
          html += '<label style="' + labelSty + '">' + escHtml(f.label) + req + '</label>';
        }

        switch (f.type) {
          case 'textarea':
            html += '<textarea ' + nameAttr + dataReq + ' placeholder="' + escHtml(f.placeholder||'') + '"></textarea>';
            break;
          case 'select':
            html += '<select ' + nameAttr + dataReq + '><option value="">Please select</option>';
            (f.options || []).forEach(function(o) {
              html += '<option value="' + escHtml(o) + '">' + escHtml(o) + '</option>';
            });
            html += '</select>';
            break;
          case 'checkbox':
            html += '<div class="sf-checkbox-group" ' + dataReq + ' data-name="' + escHtml(f.label) + '">';
            (f.options || []).forEach(function(o) {
              html += '<label><input type="checkbox" ' + nameAttr + ' value="' + escHtml(o) + '"> ' + escHtml(o) + '</label>';
            });
            html += '</div>';
            break;
          case 'file':
            html += '<input type="file" ' + nameAttr + dataReq + '>';
            break;
          case 'number':
            html += '<input type="number" ' + nameAttr + dataReq +
                    (f.min ? ' min="' + escHtml(f.min) + '"' : '') +
                    (f.max ? ' max="' + escHtml(f.max) + '"' : '') +
                    ' step="1" inputmode="numeric" placeholder="' + escHtml(f.placeholder||'') + '">';
            break;
          case 'date':
            /* min= makes the native calendar grey out earlier days; the JS
               check below covers typed-in dates. */
            html += '<input type="date" ' + nameAttr + dataReq +
                    (f.disablePastDates ? ' min="' + todayISO() + '"' : '') + '>';
            break;
          default:
            html += '<input type="' + (f.type||'text') + '" ' + nameAttr + dataReq + ' placeholder="' + escHtml(f.placeholder||'') + '">';
        }

        if (d.labelStyle === 'floating') {
          html += '<label style="position:absolute;top:4px;left:10px;font-size:10px;color:' + (d.labelColor||'#000') + ';opacity:.6;pointer-events:none;">' + escHtml(f.label) + req + '</label>';
        }

        html += '<div class="sf-field-error-msg">' + escHtml(globalExtra.requiredFieldMessage || T.requiredField) + '</div>';
        html += '</div>';
      });

      var btnAlign   = d.buttonAlignment || 'full';
      var btnJustify = btnAlign==='full' ? 'stretch' : btnAlign==='center' ? 'center' : btnAlign==='right' ? 'flex-end' : 'flex-start';
      var btnLabel   = globalExtra.submitButtonText || globalSettings.submitLabel || d.buttonText || T.submit;
      var btnStyle   = [
        'width:'         + (btnAlign==='full' ? '100%' : 'auto'),
        'background:'    + (d.buttonBg           || '#000'),
        'color:'         + (d.buttonTextColor    || '#fff'),
        'border:'        + (d.buttonBorderWidth  || '1') + 'px solid ' + (d.buttonBorderColor||'#000'),
        'border-radius:' + (d.buttonBorderRadius || '2') + 'px',
        'font-size:'     + (d.buttonFontSize     || '16') + 'px',
      ].join(';');

      html += '</div>';
      html += '<div class="smartformly-submit" style="display:flex;justify-content:' + btnJustify + ';margin-top:16px;">';
      html += '<button type="submit" style="' + btnStyle + '">' + escHtml(btnLabel) + '</button>';
      html += '</div></form>';

      container.innerHTML = html;

      container.querySelector('form').addEventListener('submit', function(e) {
        e.preventDefault();
        submitForm(e.target, container);
      });
    }

    /* ════════════════════════════════════════════
       CLIENT-SIDE VALIDATION
    ════════════════════════════════════════════ */
    function validateForm(form) {
      form.querySelectorAll('.sf-field-error').forEach(function(el) {
        el.classList.remove('sf-field-error');
      });

      var invalid = [];

      globalFields.forEach(function(f) {
        var fieldWrapper = form.querySelector('[data-field-label="' + f.label + '"]');
        var isInvalid    = false;
        var customMsg    = '';

        if (f.required) {
          if (f.type === 'checkbox') {
            var checked = form.querySelectorAll('input[name="' + f.label + '"]:checked');
            if (checked.length === 0) isInvalid = true;
          } else if (f.type === 'select') {
            var sel = form.querySelector('select[name="' + f.label + '"]');
            if (!sel || !sel.value) isInvalid = true;
          } else if (f.type === 'file') {
            var fi = form.querySelector('input[type="file"][name="' + f.label + '"]');
            if (!fi || !fi.files || fi.files.length === 0) isInvalid = true;
          } else {
            var el = form.querySelector('[name="' + f.label + '"]');
            if (!el || !el.value.trim()) isInvalid = true;
          }
        }

        /* Range and past-date checks apply to any filled-in value, whether or
           not the field is required — the browser's own validation is off
           (the form is novalidate) and typed values bypass the picker. */
        if (!isInvalid && (f.type === 'number' || f.type === 'date')) {
          var input = form.querySelector('[name="' + f.label + '"]');
          var val   = input ? String(input.value).trim() : '';

          if (val && f.type === 'number') {
            var num = Number(val);
            var min = (f.min === '' || f.min == null) ? null : Number(f.min);
            var max = (f.max === '' || f.max == null) ? null : Number(f.max);

            if (!isFinite(num) ||
                (min !== null && num < min) ||
                (max !== null && num > max)) {
              isInvalid = true;
              if (min !== null && max !== null) {
                customMsg = T.numberRange.replace('{min}', min).replace('{max}', max);
              } else if (min !== null) {
                customMsg = T.numberMin.replace('{min}', min);
              } else if (max !== null) {
                customMsg = T.numberMax.replace('{max}', max);
              }
            }
          } else if (val && f.type === 'date' && f.disablePastDates && val < todayISO()) {
            isInvalid = true;
            customMsg = T.pastDate;
          }
        }

        if (isInvalid) {
          invalid.push(f.label);
          if (fieldWrapper) {
            fieldWrapper.classList.add('sf-field-error');
            var msgEl = fieldWrapper.querySelector('.sf-field-error-msg');
            if (msgEl) {
              msgEl.textContent = customMsg || globalExtra.requiredFieldMessage || T.requiredField;
            }
          }
        }
      });

      return invalid;
    }

    /* ════════════════════════════════════════════
       SUBMIT
    ════════════════════════════════════════════ */
    async function submitForm(form, container) {
      var btn   = form.querySelector('button[type="submit"]');
      var errEl = document.getElementById('sf-error-' + formId);

      var invalidFields = validateForm(form);
      if (invalidFields.length > 0) {
        var firstInvalid = form.querySelector('.sf-field-error');
        if (firstInvalid) smoothScrollTo(firstInvalid, 20);
        return;
      }

      btn.disabled    = true;
      btn._origText   = btn.textContent;
      // Was hardcoded; the override slot is new so merchants can customize it
      // the same way as the other messages.
      btn.textContent = globalExtra.submittingText || T.submitting;
      if (errEl) errEl.style.display = 'none';

      var data = {};
      globalFields.forEach(function(f) {
        if (f.type === 'checkbox') {
          var checked = form.querySelectorAll('input[name="' + f.label + '"]:checked');
          data[f.label] = Array.from(checked).map(function(c) { return c.value; });
        } else if (f.type === 'file') {
          data[f.label] = '[file]';
        } else if (f.type === 'date') {
          /* validateForm() above reads the raw yyyy-mm-dd, so reformatting
             here leaves the past-date check untouched. */
          var dEl = form.querySelector('[name="' + f.label + '"]');
          data[f.label] = dEl ? formatDate(dEl.value, f.dateFormat) : '';
        } else {
          var el = form.querySelector('[name="' + f.label + '"]');
          data[f.label] = el ? el.value : '';
        }
      });

      try {
        /* ?locale= lets the API localize the strings it renders itself (the
           success message), which the T table above can't reach. */
        var res    = await fetch(appUrl + '/api/submit/' + formId + '?locale=' + encodeURIComponent(SF_LOCALE), {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(data),
        });
        var result = await res.json();

        if (!res.ok || !result.success) {
          var msgs = (result.errors && result.errors.length)
            ? result.errors.join(', ')
            : (result.error || globalExtra.errorMessage || T.genericError);
          if (errEl) { errEl.textContent = msgs; errEl.style.display = 'block'; }
          btn.disabled    = false;
          btn.textContent = btn._origText;
          return;
        }

        if (globalExtra.afterSubmitScript) {
          try {
            var formData = { id: formId, fields: data, result: result };
            new Function('formData', globalExtra.afterSubmitScript)(formData);
          } catch (scriptErr) {
            console.warn('[SmartFormly] afterSubmitScript error:', scriptErr);
          }
        }

        var action     = result.afterSubmissionAction || 'clear_and_allow';
        var successMsg = result.message || globalSettings.successMessage || T.success;
        var tyMsg      = result.thankYouMessage || successMsg;
        var timerSec   = Number(result.thankYouTimerSec) || 5;

        switch (action) {

          case 'redirect':
            showSuccess(container, successMsg, result.ticketNumber);
            handleScrollBehavior(container);
            setTimeout(function() { window.location.href = result.redirectUrl || window.location.href; }, 1500);
            break;

          case 'hide_and_show_message':
          case 'one_entry':
            form.style.display = 'none';
            showThankYou(container, tyMsg, timerSec, result.ticketNumber, function() {
              if (globalExtra.popupEnabled) closePopup();
            });
            setTimeout(function() { handleScrollBehavior(container); }, 50);
            break;

          case 'show_and_download':
            showSuccess(container, successMsg, result.ticketNumber);
            handleScrollBehavior(container);
            form.reset();
            btn.disabled    = false;
            btn.textContent = btn._origText;
            break;

          case 'clear_and_allow':
          default:
            showSuccess(container, successMsg, result.ticketNumber);
            handleScrollBehavior(container);
            form.reset();
            btn.disabled    = false;
            btn.textContent = btn._origText;
            if (globalExtra.popupEnabled) {
              setTimeout(function() { clearMessages(container); }, 3500);
            }
            break;
        }

      } catch (err) {
        if (errEl) { errEl.textContent = 'Network error. Please try again.'; errEl.style.display = 'block'; }
        btn.disabled    = false;
        btn.textContent = btn._origText;
      }
    }

    /* ════════════════════════════════════════════
       UI HELPERS
    ════════════════════════════════════════════ */
    function showSuccess(container, message, ticketNumber) {
      clearMessages(container);
      var el = document.createElement('div');
      el.className = 'smartformly-success';
      el.textContent = message;
      if (ticketNumber) {
        var badge = document.createElement('div');
        badge.className   = 'sf-ticket-badge';
        badge.textContent = T.ticket.replace('{number}', ticketNumber);
        el.appendChild(badge);
      }
      container.appendChild(el);
    }

    function showThankYou(container, message, timerSec, ticketNumber, onDone) {
      clearMessages(container);
      var el      = document.createElement('div');
      el.className = 'sf-thankyou';

      var msgEl = document.createElement('div');
      msgEl.className = 'sf-thankyou-msg';
      msgEl.innerHTML = escHtml(message).replace(/\n/g, '<br>');
      el.appendChild(msgEl);

      if (ticketNumber) {
        var badge = document.createElement('div');
        badge.className   = 'sf-ticket-badge';
        badge.textContent = T.ticket.replace('{number}', ticketNumber);
        el.appendChild(badge);
      }

      var timerEl = document.createElement('div');
      timerEl.className = 'sf-thankyou-timer';
      if (timerSec > 0) el.appendChild(timerEl);
      container.appendChild(el);

      if (timerSec <= 0) { if (onDone) onDone(); return; }
      var remaining = timerSec;
      timerEl.textContent = T.closingIn.replace('{seconds}', remaining);
      var interval = setInterval(function() {
        remaining--;
        timerEl.textContent = T.closingIn.replace('{seconds}', remaining);
        if (remaining <= 0) {
          clearInterval(interval);
          el.remove();
          if (onDone) onDone();
        }
      }, 1000);
    }

    function clearMessages(container) {
      container.querySelectorAll('.smartformly-success, .sf-thankyou').forEach(function(el) { el.remove(); });
    }

    loadForm();
  })();
  </script>

{% endif %}

{% schema %}
{
  "name": "t:smartformly.form.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "form_id",
      "label": "t:smartformly.form.settings.form_id.label",
      "info": "t:smartformly.form.settings.form_id.info"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:smartformly.form.settings.max_width.label",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "t:smartformly.form.settings.section_padding.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
