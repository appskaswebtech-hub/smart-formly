{% comment %}
  SmartFormly — App Embed
{% endcomment %}

<script>
  window.SmartFormlyConfig = {
    shop: {{ shop.permanent_domain | json }},
    appUrl: {{ app.metafields.smartformly.app_url | default: "" | json }}
  };
  // Make appUrl available to the form JS
  window.smartFormlyAppUrl = window.SmartFormlyConfig.appUrl;
</script>

{{ 'smart-formly.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "t:smartformly.app_embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:smartformly.app_embed.settings.paragraph.content"
    }
  ]
}
{% endschema %}
